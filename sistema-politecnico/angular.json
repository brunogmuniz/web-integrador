{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "modulo-dept-ensino": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true,
          "standalone": false
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true,
          "standalone": false
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true,
          "standalone": false
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/modulo-dept-ensino",
      "sourceRoot": "projects/modulo-dept-ensino/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/modulo-dept-ensino/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/modulo-dept-ensino/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {"glob": "**/*", "input": "projects/modulo-dept-ensino/public"},
              {"glob": "**/*", "input": "assets", "output": "/assets/"}
            ],
            "styles": [
              "projects/modulo-dept-ensino/src/styles.scss",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "assets/css/demo-12/style.bundle.min.css",
              "assets/css/demo-12/wizard-2.min.css",
              "assets/icons/line-awesome/css/line-awesome.css"
            ],
            "scripts": [
              "node_modules/@popperjs/core/dist/umd/popper.min.js",
              "node_modules/bootstrap/dist/js/bootstrap.min.js",
              "assets/js/jquery-1.12.4.min.js",
              "assets/js/vendors/jquery/dist/jquery.js",
              "assets/js/vendors/popper.js/dist/umd/popper.js",
              "assets/js/vendors/bootstrap/dist/js/bootstrap.min.js",
              "assets/js/vendors/js-cookie/src/js.cookie.js",
              "assets/js/vendors/moment/min/moment.min.js",
              "assets/js/vendors/perfect-scrollbar/dist/perfect-scrollbar.js",
              "assets/js/vendors/sticky-js/dist/sticky.min.js",
              "assets/js/vendors/tooltip.js/dist/umd/tooltip.min.js",
              "assets/js/vendors/wnumb/wNumb.js",
              "assets/js/demo-9/login-1.min.js",
              "assets/js/vendors/sweetalert/sweetalert2.min.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {"type": "initial", "maximumWarning": "500kB", "maximumError": "1MB"},
                {"type": "anyComponentStyle", "maximumWarning": "4kB", "maximumError": "8kB"}
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {"buildTarget": "modulo-dept-ensino:build:production"},
            "development": {"buildTarget": "modulo-dept-ensino:build:development"}
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {"builder": "@angular/build:extract-i18n"},
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/modulo-dept-ensino/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {"glob": "**/*", "input": "projects/modulo-dept-ensino/public"},
              {"glob": "**/*", "input": "assets", "output": "/assets/"}
            ],
            "styles": [
              "projects/modulo-dept-ensino/src/styles.scss",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "assets/css/demo-12/style.bundle.min.css",
              "assets/css/demo-12/wizard-2.min.css",
              "assets/icons/line-awesome/css/line-awesome.css",
              "assets/plugins/global/plugins.bundle.css",
              "assets/css/style.bundle.css"
            ],
            "scripts": [
              "node_modules/@popperjs/core/dist/umd/popper.min.js",
              "node_modules/bootstrap/dist/js/bootstrap.min.js",
              "assets/js/jquery-1.12.4.min.js",
              "assets/js/vendors/jquery/dist/jquery.js",
              "assets/js/vendors/popper.js/dist/umd/popper.js",
              "assets/js/vendors/bootstrap/dist/js/bootstrap.min.js",
              "assets/js/vendors/js-cookie/src/js.cookie.js",
              "assets/js/vendors/moment/min/moment.min.js",
              "assets/js/vendors/perfect-scrollbar/dist/perfect-scrollbar.js",
              "assets/js/vendors/sticky-js/dist/sticky.min.js",
              "assets/js/vendors/tooltip.js/dist/umd/tooltip.min.js",
              "assets/js/vendors/wnumb/wNumb.js",
              "assets/js/demo-9/login-1.min.js",
              "assets/js/vendors/sweetalert/sweetalert2.min.js",
              "assets/plugins/global/plugins.bundle.js",
              "assets/js/scripts.bundle.js"
            ]
          }
        }
      }
    },

